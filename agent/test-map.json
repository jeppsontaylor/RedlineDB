{
  "fast": [
    "rtk cargo fmt --check",
    "./scripts/check_file_sizes.sh",
    "rtk cargo check --workspace --locked",
    "rtk cargo test --workspace --quiet --locked"
  ],
  "clippy": [
    "rtk cargo clippy --workspace --all-targets --locked -- -D warnings"
  ],
  "hygiene": [
    "rtk cargo fmt --check",
    "./scripts/check_file_sizes.sh"
  ],
  "phase8-smoke": [
    "rtk cargo test --workspace --quiet --locked",
    "rtk cargo run -p redlinedb-cli -- --help",
    "rtk cargo run -p redlinedb-server -- --help"
  ],
  "security-local": [
    "rtk cargo audit",
    "rtk cargo deny check",
    "rtk gitleaks detect --source ."
  ],
  "package_tests": {
    "redlinedb": "rtk cargo test -p redlinedb --quiet --locked",
    "redlinedb-sql": "rtk cargo test -p redlinedb-sql --quiet --locked",
    "redlinedb-ffi": "rtk cargo test -p redlinedb-ffi --quiet --locked",
    "redlinedb-cli": "rtk cargo test -p redlinedb-cli --quiet --locked",
    "redlinedb-server": "rtk cargo test -p redlinedb-server --quiet --locked"
  }
}
